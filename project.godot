; PROGETTO (nome provvisorio)
; Progetto Godot 4.6

config_version=5

[application]

config/name="PROGETTO"
config/description="Quattro campioni fantasy, un cerchio rituale, scelte segrete. Uno solo vedrà l'alba."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/audio/sfx.gd"

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
textures/default_filters/anisotropic_filtering_level=4
